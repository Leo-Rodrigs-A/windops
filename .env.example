# Copy to repository root .env. Development credentials only.
NODE_ENV=development
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:5173
DATABASE_URL=postgresql://windops_app:windops_app_dev@127.0.0.1:5432/windops
MIGRATION_DATABASE_URL=postgresql://windops_migrator:windops_migrator_dev@127.0.0.1:5432/windops
ELECTRIC_DATABASE_URL=postgresql://windops_replication:windops_replication_dev@127.0.0.1:5432/windops
WINDOPS_APP_PASSWORD=windops_app_dev
WINDOPS_MIGRATOR_PASSWORD=windops_migrator_dev
WINDOPS_REPLICATION_PASSWORD=windops_replication_dev
ELECTRIC_URL=http://127.0.0.1:3001
ELECTRIC_SECRET=windops-development-only
EMAIL_TRANSPORT=smtp
SMTP_URL=smtp://127.0.0.1:1025
EMAIL_FROM=Wind Ops <noreply@windops.local>
AUTH_ENABLED=false
# Disabled integrations; never put secrets in VITE_ variables.
# Required only when AUTH_ENABLED=true; use at least 32 random characters.
# BETTER_AUTH_SECRET=at-least-32-random-characters
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# RESEND_API_KEY=
# VAPID_SUBJECT=mailto:operations@example.com
# VAPID_PUBLIC_KEY=
# VAPID_PRIVATE_KEY=
