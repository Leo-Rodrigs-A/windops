          "name": "workspace_invitations_email_normalized_check",
          "value": "\"workspace_invitations\".\"email\" = lower(btrim(\"workspace_invitations\".\"email\")) AND length(\"workspace_invitations\".\"email\") BETWEEN 3 AND 320"
