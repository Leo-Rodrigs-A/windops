          "value": "(\"workspace_invitations\".\"delivery_status\" = 'pending' AND \"workspace_invitations\".\"sent_at\" IS NULL AND \"workspace_invitations\".\"delivery_failed_at\" IS NULL) OR (\"workspace_invitations\".\"delivery_status\" = 'sent' AND \"workspace_invitations\".\"sent_at\" IS NOT NULL AND \"workspace_invitations\".\"delivery_failed_at\" IS NULL) OR (\"workspace_invitations\".\"delivery_status\" = 'failed' AND \"workspace_invitations\".\"sent_at\" IS NULL AND \"workspace_invitations\".\"delivery_failed_at\" IS NOT NULL AND \"workspace_invitations\".\"revoked_at\" IS NOT NULL)"
        }
      },
