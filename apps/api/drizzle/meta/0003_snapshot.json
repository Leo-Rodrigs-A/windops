          "value": "num_nonnulls(\"workspace_invitations\".\"accepted_at\", \"workspace_invitations\".\"revoked_at\", \"workspace_invitations\".\"superseded_by_invitation_id\") <= 1"
        },
        "workspace_invitations_acceptor_check": {
          "name": "workspace_invitations_acceptor_check",
