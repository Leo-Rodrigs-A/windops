{
  "name": "@windops/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/platform/database/migrate.ts",
    "test:integration": "node scripts/integration.mjs"
  },
  "dependencies": {
    "@windops/contracts": "workspace:*",
    "fastify": "5.12.7",
    "fastify-type-provider-zod": "7.0.0",
    "@fastify/swagger": "9.9.2",
    "@scalar/fastify-api-reference": "1.76.0",
    "better-auth": "1.7.12",
    "drizzle-orm": "0.45.4",
    "pg": "8.23.1",
    "zod": "4.6.7",
    "resend": "6.34.1",
    "web-push": "3.6.7",
    "nodemailer": "10.2.1",
    "dotenv": "18.0.9"
  },
  "devDependencies": {
    "typescript": "7.0.2",
    "tsx": "4.23.15",
    "drizzle-kit": "0.31.11",
    "@types/pg": "8.23.1",
    "@types/web-push": "3.6.4",
    "@types/nodemailer": "8.0.2",
    "@types/node": "22.19.15",
    "openapi-types": "12.1.3"
  }
}
