[Unit]
Description=Reconcile Wind Ops Electric sync window
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
User=root
ExecStart=/bin/bash /usr/local/sbin/windops-electric-window
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/run/docker.sock /opt/windops
