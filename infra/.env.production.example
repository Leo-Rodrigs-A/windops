# Copy to /opt/windops/infra/.env.production, permissions 0600. Never commit it.
APP_DOMAIN=windreport.com.br
LEGACY_DOMAIN=windops.devleonardo.com.br
APP_ORIGIN=https://windreport.com.br
NODE_ENV=production
HOST=0.0.0.0
PORT=3000
DATABASE_URL=postgresql://windops_app:CHANGE_ME@neon.example/windops?sslmode=verify-full
MIGRATION_DATABASE_URL=postgresql://windops_migrator:CHANGE_ME@neon-direct.example/windops?sslmode=verify-full
ELECTRIC_DATABASE_URL=postgresql://windops_replication:CHANGE_ME@neon-direct.example/windops?sslmode=verify-full
ELECTRIC_URL=http://electric:3000
ELECTRIC_SECRET=CHANGE_ME_RANDOM_SECRET
EMAIL_TRANSPORT=resend
EMAIL_FROM=Wind Ops <noreply@example.com>
AUTH_ENABLED=false
RESEND_API_KEY=CHANGE_ME
# Set AUTH_ENABLED=true and provide a persistent random secret after auth gates pass.
# BETTER_AUTH_SECRET=
# Optional Google OAuth; configure both values and the production callback in Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Optional Web Push; provide all three values together.
VAPID_SUBJECT=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# Release-only variables are stored in .release.env by the deploy script, not here.
# API_IMAGE=ghcr.io/owner/repository-api@sha256:...
# WEB_IMAGE=ghcr.io/owner/repository-web@sha256:...
